# Copy to `.env` for local development.
# Production (Render): DATABASE_URL, BETTER_AUTH_SECRET, FRONTEND_ORIGIN only.

PORT=1234

DATABASE_URL="postgresql://user:password@host:5432/dbname"

# >= 32 chars — generate: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-me-with-a-secret-of-at-least-32-characters

# Frontend URL (CORS + trustedOrigins). In production this is also the public
# auth URL when the frontend proxies /api (BETTER_AUTH_URL not needed).
FRONTEND_ORIGIN=http://localhost:3000

# Optional — only if auth is not served from FRONTEND_ORIGIN (local dev uses
# http://localhost:$PORT automatically).
# BETTER_AUTH_URL=http://localhost:1234

# OAuth (optional). Callbacks: {auth public URL}/api/auth/callback/{google|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

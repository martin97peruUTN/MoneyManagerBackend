# ----------------------------------------------------------------------------
# Money Manager backend — environment template. Copy to `.env` and fill in.
# ----------------------------------------------------------------------------

# Port the Express server listens on (default 1234).
PORT=1234

# PostgreSQL connection string (Prisma). Required.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ----------------------------------------------------------------------------
# Better Auth — authentication lives on this backend (single source of truth).
# ----------------------------------------------------------------------------
# Secret used to sign sessions/cookies (>= 32 chars). Generate one with:
#   pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-me-with-a-secret-of-at-least-32-characters

# Public URL of THIS backend. Used to build OAuth callback URLs.
BETTER_AUTH_URL=http://localhost:1234

# Exact frontend origin for CORS + trustedOrigins (no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# OAuth providers. Register these callback URLs in each provider console:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/github
# Leave blank to disable a provider (the server still boots).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
